      "name": "Health Checks",
      "item": [
        {
          "name": "API Service Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/health",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Checks the health of the core API service and confirms its Redis connection status."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"API Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"API returns healthy status & Redis is connected\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"OK\");",
                  "    pm.expect(jsonData.redis).to.eql(\"connected\");",
                  "});"
                ],
                "type": "text/javascript"
