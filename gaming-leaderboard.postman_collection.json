    {
      "name": "Leaderboard REST Endpoints",
      "item": [
        {
          "name": "Global Leaderboard (All-Time)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/api/leaderboard/global?limit={{default_limit}}",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "api",
                "leaderboard",
                "global"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "{{default_limit}}"
                }
              ]
            },
            "description": "Fetches the all-time global leaderboard sorted by score descending."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is an array of entries\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "    ",
                  "    if (jsonData.length > 0) {",
                  "        var first = jsonData[0];",
                  "        pm.expect(first).to.have.property(\"rank\");",
                  "        pm.expect(first).to.have.property(\"user_id\");",
                  "        pm.expect(first).to.have.property(\"score\");",
                  "        ",
                  "        // Validate types",
                  "        pm.expect(first.rank).to.be.a(\"number\");",
                  "        pm.expect(first.user_id).to.be.a(\"string\");",
                  "        pm.expect(first.score).to.be.a(\"number\");",
                  "        ",
                  "        // Assert descending order of scores",
                  "        var isSorted = true;",
                  "        for (var i = 1; i < jsonData.length; i++) {",
                  "            if (jsonData[i].score > jsonData[i-1].score) {",
                  "                isSorted = false;",
                  "                break;",
                  "            }",
                  "        }",
                  "        pm.expect(isSorted).to.be.true;",
                  "        ",
                  "        // Assert 1-indexed sequential ranks",
                  "        var ranksSequential = true;",
                  "        for (var i = 0; i < jsonData.length; i++) {",
                  "            if (jsonData[i].rank !== i + 1) {",
                  "                ranksSequential = false;",
                  "                break;",
                  "            }",
                  "        }",
                  "        pm.expect(ranksSequential).to.be.true;",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
